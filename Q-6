#include <stdio.h>
#include <string.h>

#define N 500
#define L 30

int main()
{
    char names[N][L], temp[L], key[L];
    int n, i, j, low, high, mid, found = 0;

    printf("Enter number of names: ");
    scanf("%d", &n);
    getchar();

    printf("Enter names:\n");

    for (i = 0; i < n; i++)
    {
        fgets(names[i], L, stdin);
        names[i][strcspn(names[i], "\n")] = '\0';
    }

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (strcmp(names[j], names[j + 1]) > 0)
            {
                strcpy(temp, names[j]);
                strcpy(names[j], names[j + 1]);
                strcpy(names[j + 1], temp);
            }
        }
    }

    printf("\nSorted Names:\n");

    for (i = 0; i < n; i++)
        printf("%s\n", names[i]);

    printf("\nDuplicate Names:\n");

    for (i = 0; i < n - 1; i++)
    {
        if (strcmp(names[i], names[i + 1]) == 0)
        {
            printf("%s\n", names[i]);
        }
    }

    printf("\nEnter name to search: ");
    fgets(key, L, stdin);
    key[strcspn(key, "\n")] = '\0';

    low = 0;
    high = n - 1;

    while (low <= high)
    {
        mid = low + (high - low) / 2;

        int result = strcmp(names[mid], key);

        if (result == 0)
        {
            found = 1;
            break;
        }
        else if (result < 0)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if (found)
        printf("Name found at index %d\n", mid);
    else
        printf("Name not found\n");

    return 0;
}
