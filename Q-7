#include <stdio.h>

#define MAX 500000
#define C 12

int main()
{
    int votes[MAX], count[C + 1] = {0};
    int candidates, n;
    int valid = 0, invalid = 0;
    int i, j, temp;
    int max = 0, tie = 0;

    printf("Enter number of candidates: ");
    scanf("%d", &candidates);

    printf("Enter number of votes: ");
    scanf("%d", &n);

    printf("Enter votes:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%d", &votes[i]);

        if (votes[i] >= 1 && votes[i] <= candidates)
        {
            count[votes[i]]++;
            valid++;
        }
        else
        {
            invalid++;
        }
    }

    printf("\nValid votes: %d\n", valid);
    printf("Invalid votes: %d\n", invalid);

    for (i = 1; i <= candidates; i++)
    {
        if (count[i] > max)
            max = count[i];
    }

    for (i = 1; i <= candidates; i++)
    {
        for (j = i + 1; j <= candidates; j++)
        {
            if (count[i] < count[j])
            {
                temp = count[i];
                count[i] = count[j];
                count[j] = temp;

                temp = votes[i - 1];
                votes[i - 1] = votes[j - 1];
                votes[j - 1] = temp;
            }
        }
    }

    printf("\nVotes for each candidate:\n");

    for (i = 1; i <= candidates; i++)
        printf("Candidate %d: %d\n", i, count[i]);

    return 0;
}
